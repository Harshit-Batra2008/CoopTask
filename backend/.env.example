# Copy this file to .env and fill in real values before running the backend.
# As of Phase 3, DATABASE_URL and JWT_SECRET are REQUIRED — the server
# will not start without JWT_SECRET, and auth routes will fail without
# a working DATABASE_URL.

PORT=4000

# Local PostgreSQL connection string. Replace USER/PASSWORD with your
# own local Postgres credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cooptask?schema=public"

# Origin of the frontend dev server — used for credentialed CORS so the
# httpOnly auth cookie is accepted correctly.
FRONTEND_ORIGIN="http://localhost:5173"

# Secret used to sign JWTs. Use a long, random value — never commit a
# real one to source control. Example of generating one locally:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-value"

# Used ONLY by prisma/seed.js to create the single controlled admin
# account. Not used by the running server. Change these before seeding
# anything beyond local testing.
ADMIN_NAME="CoopTask Admin"
ADMIN_EMAIL="admin@cooptask.local"
ADMIN_PASSWORD="ChangeMe123!"
